<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>香港商業生存大富翁 - 隨機瘋狂版</title>
    <style>
        :root {
            --board-color: #f7f9fc;
            --cell-border: #2c3e50;
            --text-color: #2c3e50;
            --primary-btn: #ff4757;
        }

        body {
            font-family: 'Microsoft JhengHei', Arial, sans-serif;
            background: linear-gradient(135deg, #ff9ff3, #feca57, #54a0ff, #00d2d3);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-color);
            min-height: 100vh;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        h1 {
            color: #fff;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.3);
            margin-bottom: 20px;
            font-size: 28px;
            letter-spacing: 2px;
        }

        .monopoly-board {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-template-rows: repeat(6, 1fr);
            width: 780px; 
            height: 780px;
            background-color: var(--board-color);
            border: 6px solid var(--cell-border);
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            position: relative;
            border-radius: 12px;
            overflow: hidden;
        }

        .cell {
            border: 1px solid var(--cell-border);
            background-color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            position: relative;
            box-sizing: border-box;
            padding: 2px;
        }

        .cell-banner {
            width: 100%;
            height: 25px;
            border-bottom: 2px solid var(--cell-border);
        }
        .banner-red { background-color: #ff6b81; }    
        .banner-orange { background-color: #ffa502; } 
        .banner-blue { background-color: #1e90ff; }   

        /* 嚴格執行：土地名字體大小固定為 15px */
        .cell-name {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2px;
            line-height: 1.3;
            font-size: 15px; 
            font-weight: bold;
        }

        .cell-price {
            font-size: 12px;
            color: #718093;
            font-weight: bold;
            margin-top: 2px;
        }

        .corner-cell {
            background-color: #fff200;
            color: #2c3e50;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* 棋盤格子佈局 */
        .cell-0 { grid-column: 6; grid-row: 6; background-color: #2ed573; color: white;} 
        .cell-1 { grid-column: 5; grid-row: 6; }
        .cell-2 { grid-column: 4; grid-row: 6; }
        .cell-3 { grid-column: 3; grid-row: 6; }
        .cell-4 { grid-column: 2; grid-row: 6; }
        .cell-5 { grid-column: 1; grid-row: 6; } 
        .cell-6 { grid-column: 1; grid-row: 5; }
        .cell-7 { grid-column: 1; grid-row: 4; }
        .cell-8 { grid-column: 1; grid-row: 3; }
        .cell-9 { grid-column: 1; grid-row: 2; }
        .cell-10 { grid-column: 1; grid-row: 1; } 
        .cell-11 { grid-column: 2; grid-row: 1; }
        .cell-12 { grid-column: 3; grid-row: 1; }
        .cell-13 { grid-column: 4; grid-row: 1; }
        .cell-14 { grid-column: 5; grid-row: 1; }
        .cell-15 { grid-column: 6; grid-row: 1; } 
        .cell-16 { grid-column: 6; grid-row: 2; }
        .cell-17 { grid-column: 6; grid-row: 3; }
        .cell-18 { grid-column: 6; grid-row: 4; }
        .cell-19 { grid-column: 6; grid-row: 5; }

        .center-dashboard {
            grid-column: 2 / 6;
            grid-row: 2 / 6;
            background-color: #f1f2f6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            text-align: center;
            border: 3px dashed #ffa502;
            margin: 5px;
            border-radius: 8px;
        }

        .status-panel {
            background: white;
            padding: 15px 20px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            width: 85%;
            border: 2px solid #74b9ff;
        }

        .player-token {
            width: 32px;
            height: 32px;
            background: radial-gradient(circle, #fffa65, #fff200);
            border-radius: 50%;
            border: 3px solid #2c3e50;
            position: absolute;
            bottom: 5px;
            right: 5px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
            z-index: 10;
        }

        .btn {
            background: linear-gradient(135deg, #ff4757, #ff6b81);
            color: white;
            border: none;
            padding: 14px 30px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(255, 71, 87, 0.4);
            transition: all 0.2s;
        }
        .btn:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 8px 25px rgba(255, 71, 87, 0.5); }
        .btn:disabled { background: #ced6e0; box-shadow: none; cursor: not-allowed; transform: none; }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(44, 62, 80, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal {
            background: white;
            padding: 30px;
            border-radius: 16px;
            max-width: 600px;
            width: 90%;
            box-shadow: 0 15px 40px rgba(0,0,0,0.4);
            border: 4px solid var(--cell-border);
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 20px 0;
        }

        .option-btn {
            background-color: #f1f2f6;
            border: 2px solid #ced6e0;
            padding: 14px 18px;
            border-radius: 8px;
            text-align: left;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
            transition: all 0.2s;
        }
        .option-btn:hover { background-color: #74b9ff; color: white; border-color: #74b9ff; }

        .explanation-box {
            margin-top: 15px;
            padding: 15px;
            background-color: #f1f2f6;
            border-left: 6px solid #2ed573;
            border-radius: 4px;
            display: none;
            font-size: 14px;
            line-height: 1.5;
        }
    </style>
</head>
<body>

    <h1>✨ 香港商業生存大富翁 ✨</h1>

    <div class="monopoly-board" id="board">
        <div class="center-dashboard">
            <div class="status-panel">
                <div style="font-size: 15px;">📍 <strong>目前位置：</strong> <span id="currentLocName" style="color:#ff4757; font-weight:bold;">準備出發</span></div>
                <div style="margin-top: 10px;">💰 <strong>手頭現金：</strong> <span id="playerMoney" style="color:#2ed573; font-size:22px; font-weight:bold;">$0</span></div>
                <div id="debtDisplay" style="margin-top: 8px; font-size:14px; color:#d63031; display:none;">🚨 <strong>未清還借貸：</strong> <span id="playerDebt">$0</span> (每回合 10% 利息)</div>
            </div>
            <button class="btn" id="rollBtn" onclick="rollDice()">🎲 擲骰前進</button>
            <div id="diceResult" style="font-size: 18px; font-weight: bold; margin-top: 15px; color: #ff4757;"></div>
        </div>
        <div class="player-token" id="playerToken"></div>
    </div>

    <div class="modal-overlay" id="quizModal">
        <div class="modal">
            <h3 id="modalCardType" style="margin-top:0; color:#ff4757; border-bottom:2px solid #ced6e0; padding-bottom:10px; font-size:18px;">📋 商業事件決策</h3>
            <p id="quizQuestion" style="font-size: 15px; line-height: 1.6; font-weight:bold; color:#2c3e50;"></p>
            <div class="options-container" id="optionsSpace"></div>
            
            <div class="explanation-box" id="explanationSpace">
                <strong id="resultStatus" style="font-size: 16px;"></strong><br><br>
                <div id="qaContent">
                    <strong>【正確商業決策】：</strong> <span id="correctAnswerStr" style="color:#2ed573; font-size:16px; font-weight:bold;"></span><br><br>
                    <strong>💡 【商業概念詳解】：</strong> <span id="explanationStr"></span>
                </div>
            </div>
            
            <button class="btn" id="closeModalBtn" style="display:none; width:100%; margin-top:15px;" onclick="closeModal()">繼續前進</button>
        </div>
    </div>

    <script>
        const businessQuestions = [
            { q: "下列哪項屬於商界對社會經濟的主要貢獻？<br>(1) 開拓海外市場賺取外匯<br>(2) 為本地市民提供就業機會<br>(3) 繳納利得稅以支援政府公共開支", options: ["A. 只有(1)及(2)", "B. 只有(1)及(3)", "C. 只有(2)及(3)", "D. (1)、(2)及(3)"], ans: "D", exp: "不論行業，賺外匯、創造就業及繳稅皆是核心經濟貢獻。" },
            { q: "大樓企業多採用「高架式組織架構」。與扁平式架構相比，下列哪項陳述是正確的？<br>(1) 擁有較多管理層級與中層管理人員。<br>(2) 其管理人員的控制幅度較窄（監督較少下屬）。<br>(3) 能更迅速地對市場環境轉變作出回應。", options: ["A. 只有(1)及(2)", "B. 只有(1)及(3)", "C. 只有(2)及(3)", "D. (1)、(2)及(3)"], ans: "A", exp: "高架式架構層級多、控制幅度窄；扁平架構反應才較快。" },
            { q: "小商號的老闆想親自分析店舖的盈利能力並與同行競爭者比較，他最應該優先查閱並分析下列哪項資料？", options: ["A. 公司股東名冊", "B. 財務報表（如利潤表）", "C. 每日員工簽到簿", "D. 銀行往來調節表"], ans: "B", exp: "財務報表是評估商號財務狀況及行業比較的標準化工具。" },
            { q: "自僱物流司機在香港強制性公積金（強積金）制度下享有哪項基本權利？", options: ["A. 若每月入息低於最低水平，可申請完全退出強積金計劃。", "B. 可以自行更改並調整其強積金帳戶內的投資組合。", "C. 每年皆可自由提取部分累算權益作周轉。", "D. 可自行決定不進行任何登記。"], ans: "B", exp: "強積金計劃成員皆享有自行更改、調整投資組合的權利。" },
            { q: "在市場環境不景氣時，下列哪位外部使用者會「同時」高度關注商號的盈利能力和變現能力（流動性）？", options: ["A. 購買普通商品的顧客", "B. 負責審查稅收的評稅官", "C. 長期供應賒銷貨物的供應商", "D. 剛入職的基層員工"], ans: "C", exp: "供應商看重你的盈利能力（長期生意）和變現能力（確保現在有錢收）。" },
            { q: "管理層對生產線員工採取「自由放任式」領導。這最可能帶來甚麼負面影響？", options: ["A. 員工因缺乏清晰指引及支援，在面對突發挑戰時容易感到沮喪與無助", "B. 員工會自動變得極具主動性與合作精神", "C. 生產效率會得到爆發性提升", "D. 企業將徹底消除所有生產延誤"], ans: "A", exp: "自由放任式領導若缺乏指引，容易令基層員工感到無所適從及沮喪。" },
            { q: "若企業或個人想在銀行與信貸機構中維持良好的信貸紀錄評級，下列哪項做法是正確的？", options: ["A. 每月只償還信用卡對帳單上的「最低還款額」", "B. 經常刷盡所有信用額度以刺激消費", "C. 在消費前評估自身的還款能力，並在截止付款日前全額清償欠款", "D. 同時向多家金融機構大量申請過度借貸"], ans: "C", exp: "理性評估還款能力並準時全額還款，是維持優良信貸紀錄的途徑。" },
            { q: "企業實行「分工」制度，讓不同員工專職負責專門工序。這對生產效率帶來的主要好處是？", options: ["A. 能百分之百提高員工的工作士氣", "B. 省去員工在轉換不同工作或工序時所浪費的時間", "C. 增加員工之間的摩擦", "D. 徹底消除企業的流動資金壓力"], ans: "B", exp: "分工減少了員工在不同崗位切換間所流失的時間。" }
        ];

        // 隨機突發情景也加入隨機金額
        function getShockScenarios() {
            let amt1 = (Math.floor(Math.random() * 3) + 2) * 1000; // 2000-4000
            let amt2 = (Math.floor(Math.random() * 3) + 1) * 1000; // 1000-3000
            return [
                { txt: `🚨 突發遭遇：遭遇瘋狂大加租！店舖被迫掏出大筆按金！`, money: -amt1 },
                { txt: `💰 突發遭遇：政府發放新一輪消費券！店舖生意突然爆滿！`, money: amt2 },
                { txt: `🚨 突發遭遇：香港遭遇超級颱風吹襲！損失一日營業額！`, money: -2000 },
                { txt: `💰 突發遭遇：你在網絡發布的短片意外爆紅！吸引大批市民排隊消費！`, money: amt1 },
                { txt: `🚨 突發遭遇：突擊消防檢查不合格，被判處高額行政罰款！`, money: -amt2 }
            ];
        }

        // 基礎地標模板 (價格會在 init 時候動態隨機注入)
        let mapCells = [
            { name: "🚀<br>創業起點<br>(獲發資金)", type: "special" },
            { name: "無良大樓", type: "red", qIdx: 0 },
            { name: "黑心小工廠", type: "orange", qIdx: 1 },
            { name: "愛心cafe", type: "blue", qIdx: 2 },
            { name: "⚡<br>突發情景<br>(隨機命運)", type: "shock" },
            { name: "☕<br>下午茶時段<br>休息一回合", type: "special" },
            { name: "血汗物流倉", type: "orange", qIdx: 3 },
            { name: "超時薪代工廠", type: "orange", qIdx: 4 },
            { name: "老字號涼茶鋪", type: "blue", qIdx: 5 },
            { name: "⚡<br>突發情景<br>(隨機命運)", type: "shock" },
            { name: "🎉<br>歡樂週末<br>派對充電區", type: "special" },
            { name: "地獄補習社", type: "blue", qIdx: 6 },
            { name: "外判清潔社", type: "blue", qIdx: 7 },
            { name: "尖端科技中心", type: "red", qIdx: 0 },
            { name: "⚡<br>突發情景<br>(隨機命運)", type: "shock" },
            { name: "🚨<br>違反限期<br>暫停前進一輪", type: "special" },
            { name: "連鎖大財團", type: "red", qIdx: 1 },
            { name: "跨國貿易城", type: "red", qIdx: 2 },
            { name: "新興電商基地", type: "orange", qIdx: 3 },
            { name: "⚡<br>突發情景<br>(隨機命運)", type: "shock" }
        ];

        let playerPos = 0;
        let playerMoney = 0;
        let playerDebt = 0; 
        let currentQuiz = null;
        let isGameOver = false;
        let isBankruptcyQuiz = false; 
        let currentCellPrice = 0; // 當前踩中地標的隨機定價

        function initBoard() {
            // 🪙 1. 隨機決定同學的開局手頭現金 ($100 - $5000，以百位數隨機)
            playerMoney = (Math.floor(Math.random() * 50) + 1) * 100;
            alert(`🎲 【開局運氣測試】\n本局你的隨機初始營運資金為：$${playerMoney.toLocaleString()}！`);
            updateUI();

            const boardEl = document.getElementById('board');
            mapCells.forEach((cell, index) => {
                const cellEl = document.createElement('div');
                cellEl.className = `cell cell-${index}`;
                
                if(cell.type === 'special' || cell.type === 'shock') {
                    cellEl.classList.add('corner-cell');
                    if(cell.type === 'shock') cellEl.style.backgroundColor = '#ffeaa7'; 
                    cellEl.innerHTML = `<div class="cell-name">${cell.name}</div>`;
                } else {
                    // 💰 2. 每個地標地方隨機定價不同價格 ($1,000 - $4,500)
                    cell.price = (Math.floor(Math.random() * 36) + 10) * 100;
                    
                    let bannerClass = '';
                    if(cell.type === 'red') bannerClass = 'banner-red';
                    if(cell.type === 'orange') bannerClass = 'banner-orange';
                    if(cell.type === 'blue') bannerClass = 'banner-blue';
                    
                    cellEl.innerHTML = `
                        <div class="cell-banner ${bannerClass}"></div>
                        <div class="cell-name">
                            ${cell.name}
                            <span class="cell-price">$${cell.price.toLocaleString()}</span>
                        </div>
                    `;
                }
                boardEl.appendChild(cellEl);
            });
            moveTokenVisual(0);
        }

        function updateUI() {
            document.getElementById('playerMoney').innerText = `$${playerMoney.toLocaleString()}`;
            if(playerDebt > 0) {
                document.getElementById('debtDisplay').style.display = 'block';
                document.getElementById('playerDebt').innerText = `$${Math.round(playerDebt).toLocaleString()}`;
            } else {
                document.getElementById('debtDisplay').style.display = 'none';
            }
        }

        function rollDice() {
            if(isGameOver) return;
            document.getElementById('rollBtn').disabled = true;

            if (playerDebt > 0) {
                let interest = playerDebt * 0.10;
                playerDebt += interest;
                alert(`🚨 利息警報：本回合自動產生 10% 延期利息：+$${Math.round(interest).toLocaleString()}！`);
                updateUI();
            }

            const dice = Math.floor(Math.random() * 6) + 1;
            document.getElementById('diceResult').innerText = `🎲 骰子點數：${dice} 點！`;
            
            playerPos = (playerPos + dice) % mapCells.length;
            
            setTimeout(() => {
                moveTokenVisual(playerPos);
                const cleanName = mapCells[playerPos].name.replace(/<br>/g, ' ');
                document.getElementById('currentLocName').innerText = cleanName;
                triggerCellEvent(playerPos);
            }, 500);
        }

        function moveTokenVisual(pos) {
            const targetCell = document.querySelector(`.cell-${pos}`);
            const token = document.getElementById('playerToken');
            targetCell.appendChild(token);
        }

        function triggerCellEvent(pos) {
            const cell = mapCells[pos];
            
            if (cell.type === 'special') {
                alert(`路過【${cell.name.replace(/<br>/g, '')}】，維持正常運作。`);
                checkBankruptcyStatus();
                return;
            }

            if (cell.type === 'shock') {
                const shocks = getShockScenarios();
                const randomShock = shocks[Math.floor(Math.random() * shocks.length)];
                alterMoney(randomShock.money);
                
                document.getElementById('modalCardType').innerText = `⚡ 突發情景！命運降臨`;
                document.getElementById('quizQuestion').innerHTML = randomShock.txt;
                document.getElementById('optionsSpace').innerHTML = '';
                
                const statusEl = document.getElementById('resultStatus');
                if(randomShock.money > 0) {
                    statusEl.innerText = `💰 資產大增 $${randomShock.money.toLocaleString()}！`;
                    statusEl.style.color = "#2ed573";
                } else {
                    statusEl.innerText = `🚨 財產扣除 $${Math.abs(randomShock.money).toLocaleString()}！`;
                    statusEl.style.color = "#ff4757";
                }
                
                document.getElementById('qaContent').style.display = 'none';
                document.getElementById('explanationSpace').style.display = 'block';
                
                const closeBtn = document.getElementById('closeModalBtn');
                closeBtn.style.display = 'block';
                closeBtn.style.backgroundColor = randomShock.money > 0 ? "#2ed573" : "#ff4757";
                
                updateUI();
                document.getElementById('quizModal').style.display = 'flex';
                return;
            }

            // 🎯 隨機定價題目：獲取的獎勵或懲罰完全根據該地方的動態價格決定
            currentCellPrice = cell.price;
            currentQuiz = businessQuestions[cell.qIdx];
            showQuizModal(currentQuiz, false);
        }

        function showQuizModal(quiz, isRescue) {
            isBankruptcyQuiz = isRescue;
            if(isRescue) {
                document.getElementById('modalCardType').innerText = `⚠️ 破產危機！最後一擊生存問答`;
                document.getElementById('modalCardType').style.color = "#d63031";
            } else {
                document.getElementById('modalCardType').innerText = `🏢 抵達地標：「${mapCells[playerPos].name.replace(/<br>/g, ' ')}」`;
                document.getElementById('modalCardType').style.color = "#ff4757";
            }
            
            // 顯示該題目的動態獎懲價格
            let reward = Math.round(currentCellPrice * 0.6);
            let penalty = Math.round(currentCellPrice * 0.4);
            let priceTip = isRescue ? "" : `<br><span style='color:#7f8c8d; font-size:13px;'>(本題動態身價：答對 +$${reward} / 答錯 -$${penalty})</span>`;
            
            document.getElementById('quizQuestion').innerHTML = quiz.q + priceTip;
            const optionsSpace = document.getElementById('optionsSpace');
            optionsSpace.innerHTML = '';
            document.getElementById('explanationSpace').style.display = 'none';
            document.getElementById('qaContent').style.display = 'block';
            document.getElementById('closeModalBtn').style.display = 'none';

            const letters = ['A', 'B', 'C', 'D'];
            quiz.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerText = opt;
                btn.onclick = () => checkAnswer(letters[idx]);
                optionsSpace.appendChild(btn);
            });

            document.getElementById('quizModal').style.display = 'flex';
        }

        function checkAnswer(userAns) {
            const buttons = document.querySelectorAll('.option-btn');
            buttons.forEach(btn => btn.disabled = true);

            const isCorrect = (userAns === currentQuiz.ans);
            const statusEl = document.getElementById('resultStatus');
            const closeBtn = document.getElementById('closeModalBtn');
            
            if (isBankruptcyQuiz) {
                if (isCorrect) {
                    statusEl.innerText = "🎉 答對了！財務公司願意為你提供緊急借貸服務！\n是否立刻借入 $5,000 生存資金？(注意：隨後每回合收取 10% 利息)";
                    statusEl.style.color = "#2ed573";
                    
                    const optionsSpace = document.getElementById('optionsSpace');
                    optionsSpace.innerHTML = ''; 
                    
                    const acceptBtn = document.createElement('button');
                    acceptBtn.className = 'option-btn';
                    acceptBtn.innerText = "🤝 同意借貸 $5,000 (每回合 10% 利息)";
                    acceptBtn.onclick = () => {
                        playerMoney = 5000;
                        playerDebt = 5000;
                        alert("借貸成功！手頭現金已回升至 $5,000，每回合會有利息累積，請快賺錢！");
                        closeModal();
                    };
                    
                    const rejectBtn = document.createElement('button');
                    rejectBtn.className = 'option-btn';
                    rejectBtn.innerText = "❌ 拒絕借貸（即時宣布破產完結遊戲）";
                    rejectBtn.onclick = () => {
                        gameOver("你拒絕了緊急借貸，公司正式資金斷裂清盤！");
                    };
                    
                    optionsSpace.appendChild(acceptBtn);
                    optionsSpace.appendChild(rejectBtn);
                } else {
                    statusEl.innerText = "❌ 答錯了！財務公司認為你缺乏商業知識，拒絕批出貸款！";
                    statusEl.style.color = "#ff4757";
                    document.getElementById('qaContent').style.display = 'none';
                    document.getElementById('explanationSpace').style.display = 'block';
                    gameOver("答錯了救援題，沒有機構願意借貸，遊戲即時完結！");
                }
                return;
            }

            // 依地標身價動態計算獎懲
            let rewardAmt = Math.round(currentCellPrice * 0.6);
            let penaltyAmt = Math.round(currentCellPrice * 0.4);

            if (isCorrect) {
                statusEl.innerText = `🎉 決策正確！成功拓展業務，賺取該地隨機定價利潤 $${rewardAmt.toLocaleString()}！`;
                statusEl.style.color = "#2ed573";
                closeBtn.style.backgroundColor = "#27ae60";
                alterMoney(rewardAmt);
            } else {
                statusEl.innerText = `❌ 決策失誤！遭遇商業虧損，損失該地隨機定價成本 $${penaltyAmt.toLocaleString()}！`;
                statusEl.style.color = "#ff4757";
                closeBtn.style.backgroundColor = "#ff4757";
                alterMoney(-penaltyAmt);
            }

            document.getElementById('correctAnswerStr').innerText = currentQuiz.ans;
            document.getElementById('explanationStr').innerText = currentQuiz.exp;
            document.getElementById('explanationSpace').style.display = 'block';
            closeBtn.style.display = 'block';
            updateUI();
        }

        function alterMoney(amount) {
            if (amount > 0 && playerDebt > 0) {
                if (amount >= playerDebt) {
                    amount -= playerDebt;
                    playerDebt = 0;
                    playerMoney += amount;
                    alert("🎉 太好了！你賺取的資金已自動全額還清了所有債務！");
                } else {
                    playerDebt -= amount;
                    alert(`💰 賺取的 $${amount.toLocaleString()} 已自動用作償還部分欠債。還欠 $${Math.round(playerDebt).toLocaleString()}`);
                }
            } else {
                playerMoney += amount;
            }
        }

        function checkBankruptcyStatus() {
            if (playerMoney <= 0) {
                setTimeout(() => {
                    let randomQuiz = businessQuestions[Math.floor(Math.random() * businessQuestions.length)];
                    showQuizModal(randomQuiz, true);
                }, 600);
            } else {
                document.getElementById('rollBtn').disabled = false;
            }
        }

        function closeModal() {
            document.getElementById('quizModal').style.display = 'none';
            checkBankruptcyStatus();
        }

        function gameOver(message) {
            isGameOver = true;
            document.getElementById('quizModal').style.display = 'none';
            document.getElementById('rollBtn').disabled = true;
            document.getElementById('rollBtn').innerText = "💀 遊戲已完結";
            alert(`💀 【GAME OVER - 破產清盤】\n\n${message}`);
        }

        window.onload = initBoard;
    </script>
</body>
</html>
